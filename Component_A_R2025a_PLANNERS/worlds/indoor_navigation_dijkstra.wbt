# Static concrete barriers. These coordinates match the live design preview
# and the 0.24 m occupancy-grid map used by both planners.
DEF OBSTACLE_1 Solid {
  translation -3.84 0.30 -2.88
  name "Concrete barrier 01"
  model "Concrete navigation barrier"
  recognitionColors [ 0.46 0.47 0.45 ]
  children [
    Shape { appearance PBRAppearance { baseColor 0.43 0.45 0.44 roughness 0.96 } geometry Box { size 0.48 0.60 3.84 } }
    Transform { translation 0 0.306 0 children [ Shape { appearance PBRAppearance { baseColor 0.53 0.54 0.51 roughness 0.92 } geometry Box { size 0.50 0.012 3.86 } } ] }
