#VRML_SIM R2025a utf8
WorldInfo {
  title "Component A - Rover Navigation Arena"
  basicTimeStep 50
  coordinateSystem "NUE"
}
Viewpoint {
  orientation -0.667786633 0.667786633 0.328819138 2.506228070
  position 0 10 13
  description "Arena overview"
}
# Built-in nodes only: no external PROTO files or network downloads required.
Background { skyColor [ 0.65 0.73 0.82 ] }
DirectionalLight {
  direction -0.4 -1 -0.3
  ambientIntensity 0.45
  intensity 1
  castShadows TRUE
}

# A pale concrete floor with fine grout lines, matching the design preview.
DEF ARENA_FLOOR Solid {
  translation 0 -0.05 0
  name "arena floor"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.70 0.69 0.64 roughness 1 }
      geometry Box { size 12 0.10 12 }
    }
    # North/south grout lines.
    Transform { translation -5.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    Transform { translation -4.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    Transform { translation -3.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    Transform { translation -2.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    Transform { translation -1.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    Transform { translation -0.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    Transform { translation 0.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    Transform { translation 1.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    Transform { translation 2.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    Transform { translation 3.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    Transform { translation 4.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    Transform { translation 5.5 0.051 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 12 } } ] }
    # East/west grout lines.
    Transform { translation 0 0.051 -5.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
    Transform { translation 0 0.051 -4.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
    Transform { translation 0 0.051 -3.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
    Transform { translation 0 0.051 -2.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
    Transform { translation 0 0.051 -1.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
    Transform { translation 0 0.051 -0.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
    Transform { translation 0 0.051 0.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
    Transform { translation 0 0.051 1.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
    Transform { translation 0 0.051 2.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
    Transform { translation 0 0.051 3.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
    Transform { translation 0 0.051 4.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
    Transform { translation 0 0.051 5.5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 12 0.002 0.012 } } ] }
  ]
  boundingObject Box { size 12 0.10 12 }
}

# Tall dark perimeter walls.
DEF WALL_NORTH Solid {
  translation 0 0.65 -5.98
  name "north wall"
  children [ Shape { appearance PBRAppearance { baseColor 0.12 0.18 0.25 roughness 0.94 } geometry Box { size 12.2 1.30 0.16 } } ]
  boundingObject Box { size 12.2 1.30 0.16 }
}
