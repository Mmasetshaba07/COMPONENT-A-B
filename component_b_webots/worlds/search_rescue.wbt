    Transform { translation 0 0.061 -6 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 18 0.002 0.012 } } ] }
    Transform { translation 0 0.061 -5 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 18 0.002 0.012 } } ] }
