#VRML_SIM R2023b utf8
WorldInfo {
  basicTimeStep 64
  title "Multi-Robot Search and Rescue — Component B"
  coordinateSystem "NUE"
}
DEF SWARM_SUPERVISOR Robot {
  name "Swarm Simulation Supervisor"
  supervisor TRUE
  controller "swarm_supervisor"
  children [ ]
}
Viewpoint {
  orientation -0.667786633 0.667786633 0.328819138 2.506228070
  position 0 15 19.5
  description "Arena overview"
}
Background {
  skyColor [ 0.65 0.73 0.82 ]
}
DirectionalLight {
  direction -0.4 -1 -0.3
  ambientIntensity 0.45
  intensity 1
  castShadows TRUE
}

# Open courtyard floor
Solid {
  translation 0 -0.06 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.70 0.69 0.64
        roughness 1
        metalness 0
      }
      geometry Box { size 18 0.12 14 }
    }
    # Fine grout lines give the courtyard the same flat tiled appearance as Component A.
    Transform { translation -8 0.061 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 14 } } ] }
    Transform { translation -7 0.061 0 children [ Shape { appearance PBRAppearance { baseColor 0.60 0.59 0.55 roughness 1 } geometry Box { size 0.012 0.002 14 } } ] }
