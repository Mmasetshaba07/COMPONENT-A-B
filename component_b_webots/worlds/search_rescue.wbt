# Courtyard obstacles. The controller uses these same rectangles for A* planning.
DEF OBSTACLE_1 Solid {
  translation -1.0 0.55 0.0
  children [ Shape { appearance PBRAppearance { baseColor 0.40 0.43 0.43 roughness 0.9 } geometry Box { size 1.4 1.1 3.2 } } ]
  name "Central planter wall"
  boundingObject Box { size 1.4 1.1 3.2 }
}
DEF OBSTACLE_2 Solid {
  translation 3.0 0.45 -2.2
  children [ Shape { appearance PBRAppearance { baseColor 0.49 0.46 0.40 roughness 1 } geometry Box { size 2.2 0.9 1.1 } } ]
  name "North-east barrier"
  boundingObject Box { size 2.2 0.9 1.1 }
}
DEF OBSTACLE_3 Solid {
  translation 2.1 0.45 2.4
  children [ Shape { appearance PBRAppearance { baseColor 0.49 0.46 0.40 roughness 1 } geometry Box { size 1.0 0.9 2.0 } } ]
  name "South-east barrier"
  boundingObject Box { size 1.0 0.9 2.0 }
}
DEF OBSTACLE_4 Solid {
  translation -4.0 0.35 -2.5
  children [ Shape { appearance PBRAppearance { baseColor 0.39 0.47 0.37 roughness 1 } geometry Box { size 1.4 0.7 1.2 } } ]
  name "West courtyard planter"
  boundingObject Box { size 1.4 0.7 1.2 }
}

# Robot agents are Robot nodes. The Supervisor runs the reproducible kinematic model
# and changes their poses; no physical motors or ROS/Gazebo are required.
DEF ROBOT_1 Robot {
  translation -6 0.14 3.8
  name "Robot 1 — Leader / Explorer"
  controller "<none>"
  children [
    Shape { appearance PBRAppearance { baseColor 0.88 0.16 0.15 roughness 0.65 } geometry Cylinder { radius 0.26 height 0.28 } }
    Transform { translation 0 0.17 0 children [ Shape { appearance PBRAppearance { baseColor 0.98 0.47 0.38 roughness 0.6 } geometry Sphere { radius 0.13 } } ] }
    Transform { translation 0 0.02 -0.25 children [ Shape { appearance PBRAppearance { baseColor 0.16 0.16 0.18 roughness 0.8 } geometry Box { size 0.10 0.09 0.12 } } ] }
  ]
  boundingObject Cylinder { radius 0.26 height 0.28 }
}
DEF ROBOT_2 Robot {
  translation -6 0.14 0
  name "Robot 2 — Searcher"
  controller "<none>"
  children [
    Shape { appearance PBRAppearance { baseColor 0.10 0.36 0.91 roughness 0.65 } geometry Cylinder { radius 0.26 height 0.28 } }
    Transform { translation 0 0.17 0 children [ Shape { appearance PBRAppearance { baseColor 0.44 0.68 0.98 roughness 0.6 } geometry Sphere { radius 0.13 } } ] }
    Transform { translation 0 0.02 -0.25 children [ Shape { appearance PBRAppearance { baseColor 0.16 0.16 0.18 roughness 0.8 } geometry Box { size 0.10 0.09 0.12 } } ] }
  ]
  boundingObject Cylinder { radius 0.26 height 0.28 }
}
DEF ROBOT_3 Robot {
  translation -6 0.14 -3.8
  name "Robot 3 — Searcher"
  controller "<none>"
  children [
    Shape { appearance PBRAppearance { baseColor 0.10 0.68 0.30 roughness 0.65 } geometry Cylinder { radius 0.26 height 0.28 } }
    Transform { translation 0 0.17 0 children [ Shape { appearance PBRAppearance { baseColor 0.45 0.88 0.55 roughness 0.6 } geometry Sphere { radius 0.13 } } ] }
    Transform { translation 0 0.02 -0.25 children [ Shape { appearance PBRAppearance { baseColor 0.16 0.16 0.18 roughness 0.8 } geometry Box { size 0.10 0.09 0.12 } } ] }
  ]
  boundingObject Cylinder { radius 0.26 height 0.28 }
}

# Three rescue targets, one assigned to each robot by the swarm optimizer.
DEF VICTIM_1 Solid {
  translation 6 0.25 3.8
  children [
    Shape { appearance PBRAppearance { baseColor 0.95 0.08 0.07 roughness 0.5 emissiveColor 0.18 0.01 0.01 } geometry Cone { bottomRadius 0.26 height 0.5 } }
    Transform { translation 0 0.38 0 children [ Shape { appearance PBRAppearance { baseColor 1 0.2 0.15 emissiveColor 0.2 0 0 } geometry Sphere { radius 0.10 } } ] }
  ]
  name "Victim target 1"
}
DEF VICTIM_2 Solid {
  translation 6 0.25 0
  children [
    Shape { appearance PBRAppearance { baseColor 0.95 0.08 0.07 roughness 0.5 emissiveColor 0.18 0.01 0.01 } geometry Cone { bottomRadius 0.26 height 0.5 } }
    Transform { translation 0 0.38 0 children [ Shape { appearance PBRAppearance { baseColor 1 0.2 0.15 emissiveColor 0.2 0 0 } geometry Sphere { radius 0.10 } } ] }
  ]
  name "Victim target 2"
}
DEF VICTIM_3 Solid {
  translation 6 0.25 -3.8
  children [
    Shape { appearance PBRAppearance { baseColor 0.95 0.08 0.07 roughness 0.5 emissiveColor 0.18 0.01 0.01 } geometry Cone { bottomRadius 0.26 height 0.5 } }
    Transform { translation 0 0.38 0 children [ Shape { appearance PBRAppearance { baseColor 1 0.2 0.15 emissiveColor 0.2 0 0 } geometry Sphere { radius 0.10 } } ] }
  ]
  name "Victim target 3"
}

# Start-zone and labels
Solid {
  translation -6.1 0.005 0
  children [ Shape { appearance PBRAppearance { baseColor 0.35 0.85 0.39 transparency 0.48 } geometry Box { size 2.0 0.01 9.0 } } ]
  name "Start area"
}
