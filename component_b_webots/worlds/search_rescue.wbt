# Perimeter walls
DEF NORTH_WALL Solid {
  translation 0 0.55 -6.8
  children [ Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.58 roughness 1 } geometry Box { size 18 1.1 0.35 } } ]
  name "North perimeter wall"
  boundingObject Box { size 18 1.1 0.35 }
}
DEF SOUTH_WALL Solid {
  translation 0 0.55 6.8
  children [ Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.58 roughness 1 } geometry Box { size 18 1.1 0.35 } } ]
  name "South perimeter wall"
  boundingObject Box { size 18 1.1 0.35 }
}
DEF WEST_WALL Solid {
  translation -8.8 0.55 0
  children [ Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.58 roughness 1 } geometry Box { size 0.35 1.1 13.6 } } ]
  name "West perimeter wall"
  boundingObject Box { size 0.35 1.1 13.6 }
}
DEF EAST_WALL Solid {
  translation 8.8 0.55 0
  children [ Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.58 roughness 1 } geometry Box { size 0.35 1.1 13.6 } } ]
  name "East perimeter wall"
  boundingObject Box { size 0.35 1.1 13.6 }
